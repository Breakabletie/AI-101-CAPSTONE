    },
    {
      "label": "Run PLR Test Suite",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Generate Satellite Tasks",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File tools/generate_satellite_tasks.ps1",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
