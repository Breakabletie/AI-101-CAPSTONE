{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PLR Verification Program",
      "type": "shell",
      "command": "node tools/check_plr_tasks.js",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
